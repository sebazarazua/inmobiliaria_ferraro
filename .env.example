HOST=127.0.0.1
PORT=4173
# Sólo PROD; se conserva DATABASE_URL como alias legado para la cartera existente.
# DEV y TEST usan sus propios clústeres y manifiestos privados.
PROD_DATABASE_URL=postgresql://usuario:clave@127.0.0.1:54329/inmobiliaria
AUTO_MIGRATE=false
PUBLIC_BASE_URL=http://localhost:5173

# OCR local opcional: requiere Poppler (pdftoppm), Tesseract y datos spa en PATH.
# El texto OCR siempre requiere cotejo humano; ningún PDF se envía a terceros.
LATE_FEE_OCR=false

# WhatsApp Business Platform / Meta Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=ferraro-whatsapp-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v20.0
WHATSAPP_SESSION_TTL_HOURS=720
WHATSAPP_PENDING_AUTH_TTL_MINUTES=30
WHATSAPP_MAX_AUTH_ATTEMPTS=3
OWNER_PORTAL_TOKEN_TTL_MINUTES=15

# Gateway publico fijo en Vercel para webhooks de Meta
WHATSAPP_GATEWAY_URL=https://ferraro-whatsapp.vercel.app
FERRARO_GATEWAY_SECRET=
WHATSAPP_GATEWAY_POLL_INTERVAL_MS=10000
WHATSAPP_GATEWAY_BATCH_SIZE=5
WHATSAPP_LOCAL_WEBHOOK_ENABLED=false
